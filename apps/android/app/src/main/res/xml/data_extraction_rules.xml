<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: profiles.json holds leshiy:// credentials, and the split rules are
     a list of what the user circumvents. Android 12+ ignores allowBackup="false" for device-to-device
     transfer, so both channels are excluded explicitly. Servers move via the encrypted vault backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
